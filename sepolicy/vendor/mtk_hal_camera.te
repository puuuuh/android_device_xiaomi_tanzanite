allow mtk_hal_camera camera_persist_file:{ dir file } { r_dir_perms r_file_perms };
allow mtk_hal_camera persist_data_file:{ dir file } { r_dir_perms r_file_perms };
allow mtk_hal_camera sysfs_therm:dir r_dir_perms;
allow mtk_hal_camera sysfs_therm:file rw_file_perms;

allow mtk_hal_camera vendor_camera_data_file:dir rw_dir_perms;
allow mtk_hal_camera vendor_camera_data_file:file create_file_perms;

dontaudit mtk_hal_camera default_prop:file { read write };
