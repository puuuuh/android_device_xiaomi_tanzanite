bluetooth.device_id.vendor_id=0x038F
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true

media.stagefright.thumbnail.prefer_hw_codecs=true
persist.mtk_telecom_max_ringingcall_number=1
persist.sys.fuse.passthrough.enable=true
persist.sys.gps.selfRecovery=3
persist.sys.mdlog_dumpback=2
persist.traced.enable=1
persist.vendor.connsysfw.enable=true
persist.vendor.mdlog.flush_log_ratio=0
persist.vendor.mdlog.max_dump_file_count=10,*.muxz,*.bin
persist.vendor.mdlog.need_dump=1
persist.vendor.mtk_rtt_support=1
persist.vendor.pms_removable=1
persist.vendor.vzw_device_type=0
persist.vendor.wfc.sys_wfc_support=1

# Audio
ro.audio.flinger_standbytime_ms=2000
ro.audio.ihaladaptervendorextension_enabled=true
ro.audio.usb.period_us=16000
ro.vendor.audio.notification.single=true

ro.config.per_app_memcg=false
ro.cp_system_other_odex=1
ro.dalvik.vm.native.bridge=0

# Radio
ro.radio.device_type=1

# MTKPerf
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1

ro.zygote.preload.enable=1

# async property set
ro.property_service.async_persist_writes=true

# Disable dirty region for Mali
debug.hwui.render_dirty_regions=false

ro.vendor.sensors.xiaomi.udfps=true
persist.vendor.fingerprint.sensor_location=540|2110|105
persist.vendor.fingerprint.type=udfps_optical

ro.vendor.system.mtk_mapi_support=1
